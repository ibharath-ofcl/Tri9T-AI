# Tri9T-AI Configuration Example
APP_NAME=Tri9T-CT200-DocIntelligence
APP_ENV=development
DEBUG=True
DATABASE_URL=sqlite:///./tri9t_documents.db

# Document Store Selection: 'json' (default, zero-dependency) or 'mongo'
TEST_SUITE_STORE_TYPE=json
# MONGO_URI=mongodb://localhost:27017
# MONGO_DATABASE_NAME=tri9t_qa
# MONGO_COLLECTION_NAME=generated_test_suites

# LLM Provider Configuration
# Set LLM_PROVIDER to 'openai' for live API calls, or 'mock' for deterministic local testing & demos
LLM_PROVIDER=mock
# LLM_API_KEY=your-openai-api-key-here
LLM_API_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=30.0
LLM_MAX_RETRIES=3
